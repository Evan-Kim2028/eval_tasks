# Copy to .env (gitignored). Do not commit tokens.

# Claude Code subscription (cheap + frontier):
#   claude setup-token
# then:
# CLAUDE_CODE_OAUTH_TOKEN=

# GLM trials via Morph LLM (mini-swe-agent; use openai/ model IDs + Morph base URL):
# MORPH_API_KEY=
# MSWEA_API_KEY=   # same value; harbor requires this for mini-swe-agent
# OPENAI_API_KEY=  # same value; litellm openai/ route to Morph
# OPENAI_BASE_URL=https://api.morphllm.com/v1
# OPENAI_API_BASE=https://api.morphllm.com/v1
# Optional legacy OpenRouter:
# OPENROUTER_API_KEY=

# Optional if you use API agents instead of Claude Code / Codex CLI:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
